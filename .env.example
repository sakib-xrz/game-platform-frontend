# Backend HTTP API, including /api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Backend Socket.IO origin, without /api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:8000

# Local development only. Backend must have ALLOW_DEV_IDENTITY_HEADER=true.
# Remove this when real authentication is connected.
NEXT_PUBLIC_DEV_USER_ID=user-001
