# Backend HTTP API (must include /api/v1)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Socket.IO origin (no /api/v1 suffix)
NEXT_PUBLIC_SOCKET_URL=http://localhost:8000

# Development-only identity fallback. Prefer ?user= or the DEV player switcher for multi-player tests.
NEXT_PUBLIC_DEV_USER_ID=user-001

# Multi-player local test URLs (open each in a separate browser tab):
# http://localhost:3000/games/greedy?user=player-1
# http://localhost:3000/games/greedy?user=player-2
# http://localhost:3000/games/teen-patti?user=player-1
# http://localhost:3000/games/teen-patti?user=player-2
# http://localhost:3000/?user=player-1
# http://localhost:3000/?user=player-2
